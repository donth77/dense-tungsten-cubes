{
  "name": "dense",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A browser physics toy about density. Tungsten cubes vs everything else.",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10.14 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:physics": "vitest run --config vitest.physics.config.ts",
    "smoke": "playwright test",
    "lint": "eslint src tests && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "eslint": "^10.8.1",
    "lil-gui": "^0.21.0",
    "meshoptimizer": "^1.2.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "stats-gl": "4.2",
    "three-pinata": "^0.1.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
